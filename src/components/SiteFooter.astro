---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();

interface Props {
  /** Show only the copyright line — for standalone pages. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;

const links = [
  { href: withBase('/resources/'), label: 'Resources' },
  { href: withBase('/community/'), label: 'Community' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/contact/'), label: 'Contact' },
];
---

<footer class:list={['site-footer', { minimal }]}>
  {!minimal && (
    <div class="container footer-inner">
      <div class="footer-brand">
        <a class="footer-mark" href={withBase('/')} aria-label="Rainbow Circuits home">
          <img src={withBase('/images/rainbow-circuits-mark.png')} alt="Rainbow Circuits rainbow circuit mark" width="96" height="96" />
        </a>
        <p class="footer-tagline">{SITE.strapline}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <p class="footer-contact">
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      </p>
    </div>
  )}
  <div class="footer-meta">
    <p class="footer-copy">© {year} Rainbow Circuits · Made with kindness, glitter, and a little harmless chaos.</p>
    <p class="footer-credit">Website designed and built by Felix Greyson and Ryuu Kurogane.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background:
      radial-gradient(ellipse 60% 100% at 15% 0%, rgba(110, 70, 184, 0.06), transparent 60%),
      radial-gradient(ellipse 50% 100% at 88% 0%, rgba(30, 115, 216, 0.06), transparent 60%),
      linear-gradient(180deg, transparent, rgba(3, 43, 103, 0.05));
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    padding-block: 2rem 1rem;
  }
  .footer-brand { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .footer-mark { display: inline-flex; border-radius: 50%; }
  .footer-mark :global(img) { width: 4.25rem; height: 4.25rem; object-fit: contain; filter: drop-shadow(0 5px 12px rgba(3, 43, 103, 0.12)); }
  :global(html[data-theme='dark']) .footer-mark :global(img) { filter: drop-shadow(0 5px 14px rgba(127, 189, 255, 0.18)); }
  .footer-tagline {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--navy);
    max-width: 16rem;
  }
  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    list-style: none;
  }
  .footer-nav a {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-light);
    text-decoration: none;
  }
  .footer-nav a:hover { color: var(--blue); }
  .footer-contact a {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .footer-meta {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-light);
    padding: 0.5rem var(--gutter) 1.5rem;
    border-top: 1px solid rgba(60, 90, 150, 0.08);
  }
  .footer-copy,
  .footer-credit {
    margin: 0;
  }
  .footer-credit {
    margin-top: 0.25rem;
  }
  .site-footer.minimal { margin-top: 3rem; }
  .site-footer.minimal .footer-meta { border-top: none; padding-top: 1.5rem; }
</style>

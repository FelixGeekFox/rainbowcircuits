---
import { withBase } from '../../lib/site';
import SectionIntro from '../SectionIntro.astro';

/**
 * The "what should we do next?" prompt in the newsletter. Keeps the intro
 * here and sends readers to the dedicated survey page (/feedback/) via a
 * button, so the long form lives on its own.
 * data: { intro?: string, ctaLabel?: string }
 */
interface Props {
  kicker?: string;
  title: string;
  data: Record<string, any>;
}
const { kicker, title, data } = Astro.props;
---

<SectionIntro kicker={kicker} title={title} />
{data.intro && <p class="feedback-intro">{data.intro}</p>}

<div class="feedback-cta">
  <a class="btn btn-primary" href={withBase('/feedback/')}>
    {data.ctaLabel ?? 'Take the 2-minute survey'} <span aria-hidden="true">🐦</span>
  </a>
  <p class="feedback-cta-note">Anonymous and low-pressure — even a single checkbox helps.</p>
</div>

<style>
  .feedback-intro {
    text-align: center;
    max-width: 42rem;
    margin: -1rem auto 2rem;
    font-size: 1.05rem;
    color: var(--text);
  }
  .feedback-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }
  .feedback-cta-note { font-size: 0.9rem; color: var(--text-light); }
</style>

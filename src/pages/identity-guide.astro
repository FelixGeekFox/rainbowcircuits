---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';

/**
 * A friendly reference to pronouns and queer flags/identities. Flags are
 * drawn in CSS from their known stripe colours (no external images), so the
 * page is self-contained. This is an introduction, not an exhaustive or
 * prescriptive list — language grows, and self-identification is what counts.
 */
type Stripe = string | [string, number];
interface Flag {
  name: string;
  desc: string;
  stripes: Stripe[];
  overlay?: 'chevron' | 'chevron-intersex' | 'triangle' | 'intersex';
  /** Draw stripes side-by-side (vertical bars) instead of stacked. */
  vertical?: boolean;
}
const stripeColor = (s: Stripe) => (Array.isArray(s) ? s[0] : s);
const stripeWeight = (s: Stripe) => (Array.isArray(s) ? s[1] : 1);

const RAINBOW: Stripe[] = ['#e40303', '#ff8c00', '#ffed00', '#008026', '#004dff', '#750787'];
const CHEVRON: Stripe[] = ['#ffffff', '#ffafc8', '#74d7ee', '#613915', '#000000'];

const communityFlags: Flag[] = [
  { name: 'Rainbow Pride', stripes: RAINBOW, desc: 'Gilbert Baker’s 1978 flag — red for life, orange for healing, yellow for sunlight, green for nature, blue for harmony, violet for spirit. The original had eight stripes, including hot pink (sex) and turquoise (art).' },
  { name: 'Progress Pride', stripes: RAINBOW, overlay: 'chevron', desc: 'Daniel Quasar’s redesign adds a forward-pointing chevron — white, pink and light blue for trans people, brown and black for queer people of colour and those lost to AIDS.' },
  { name: 'Intersex-Inclusive Progress', stripes: RAINBOW, overlay: 'chevron-intersex', desc: 'Builds on the Progress flag with Valentino Vecchietti’s intersex symbol — a purple circle on yellow — so intersex people are represented too.' },
  { name: 'Philadelphia Pride', stripes: ['#000000', '#613915', ...RAINBOW], desc: 'Adds black and brown stripes above the rainbow to centre the experiences of queer people of colour.' },
];

const attractionFlags: Flag[] = [
  { name: 'Lesbian', stripes: ['#d52d00', '#ff9a56', '#ffffff', '#d362a4', '#a30262'], desc: 'Women (and many nonbinary people) attracted to women. Emily Gwen’s 2018 “sunset” flag is an inclusive signal for the whole sapphic spectrum — butch, femme, and nonbinary lesbians.' },
  { name: 'Gay / MLM', stripes: ['#078d70', '#99e8c2', '#ffffff', '#7bade1', '#3d1a78'], desc: 'Men (and many nonbinary people) loving men — greens for community and healing fading through white into blues for love and fortitude.' },
  { name: 'Bisexual', stripes: [['#d60270', 2], ['#9b4f96', 1], ['#0038a8', 2]], desc: 'Attraction to two or more genders. Michael Page’s 1998 flag: pink for same-gender attraction, blue for different-gender, and the narrow lavender overlap as a distinct meeting point.' },
  { name: 'Pansexual', stripes: ['#ff218c', '#ffd800', '#21b1ff'], desc: 'Attraction to people regardless of gender — pink, yellow and blue for all along and beyond the gender spectrum.' },
  { name: 'Omnisexual', stripes: ['#fe9ace', '#ff53bf', '#200044', '#6760fe', '#8ea6ff'], desc: 'Attraction to all genders, where a person’s gender still plays a part in the attraction.' },
  { name: 'Polysexual', stripes: ['#f61cb9', '#07d569', '#1c92f6'], desc: 'Attraction to many, but not necessarily all, genders.' },
  { name: 'Asexual', stripes: ['#000000', '#a3a3a3', '#ffffff', '#800080'], desc: 'Little or no sexual attraction. Ace is a spectrum — grey-ace and demisexual sit under the same umbrella.' },
  { name: 'Demisexual', stripes: [['#ffffff', 1], ['#8b008b', 0.5], ['#d3d3d3', 1]], overlay: 'triangle', desc: 'Sexual attraction only after a strong emotional bond has formed.' },
  { name: 'Aromantic', stripes: ['#3da542', '#a7d379', '#ffffff', '#a9a9a9', '#000000'], desc: 'Little or no romantic attraction — green as the opposite of romance-red. Part of the split-attraction model, which separates romantic from sexual desire.' },
  { name: 'Aroace', stripes: ['#e28c00', '#eccd00', '#ffffff', '#62aedc', '#203856'], desc: 'A whole identity for people who are both aromantic and asexual — orange for community, yellow for non-romantic love, white for wholeness, blues for the spectrum.' },
  { name: 'Abrosexual', stripes: ['#47cd9a', '#a5e5c1', '#ffffff', '#f9a9c6', '#ee1766'], desc: 'An orientation that shifts and changes over time, moving between different attractions.' },
];

const genderFlags: Flag[] = [
  { name: 'Transgender', stripes: ['#5bcefa', '#f5a9b8', '#ffffff', '#f5a9b8', '#5bcefa'], desc: 'People whose gender differs from the one they were assigned at birth. Designed by Monica Helms.' },
  { name: 'Nonbinary', stripes: ['#fcf434', '#ffffff', '#9c5cd4', '#2c2c2c'], desc: 'Genders outside the man/woman binary. Designed by 17-year-old Kye Rowan in 2014 — yellow (outside the binary), white (many/all genders), purple (a mix), black (without gender).' },
  { name: 'Genderqueer', stripes: ['#b57edc', '#ffffff', '#4a8123'], desc: 'Gender that troubles or moves beyond conventional categories — lavender, white and green.' },
  { name: 'Genderfluid', stripes: ['#ff75a2', '#ffffff', '#be18d6', '#000000', '#333ebd'], desc: 'A gender that shifts and flows over time rather than staying fixed.' },
  { name: 'Agender', stripes: ['#000000', '#b9b9b9', '#ffffff', '#b8f483', '#ffffff', '#b9b9b9', '#000000'], desc: 'Without gender, or gender-neutral. The green stripe is the inverse of purple to signal an absence of gender.' },
  { name: 'Bigender', stripes: ['#c479a2', '#eca6cb', '#d6c7e8', '#ffffff', '#d6c7e8', '#9ac7e8', '#6d82d1'], desc: 'Having two genders, either at once or moving between them.' },
  { name: 'Androgyne', stripes: ['#f4a8c9', '#b088c9', '#7ea6dd'], vertical: true, desc: 'A blend of masculine and feminine. The vertical pink, purple and blue bars signal both present at once rather than shifting between them.' },
  { name: 'Demiboy', stripes: ['#7f7f7f', '#c4c4c4', '#99d9ea', '#ffffff', '#99d9ea', '#c4c4c4', '#7f7f7f'], desc: 'A partial connection to being a boy or man, whatever else one is alongside it.' },
  { name: 'Demigirl', stripes: ['#7f7f7f', '#c4c4c4', '#ffa6d3', '#ffffff', '#ffa6d3', '#c4c4c4', '#7f7f7f'], desc: 'A partial connection to being a girl or woman, whatever else one is alongside it.' },
  { name: 'Intersex', stripes: ['#ffd800'], overlay: 'intersex', desc: 'People born with sex characteristics that don’t fit typical binary definitions. Morgan Carpenter’s unbroken purple circle stands for wholeness and bodily autonomy.' },
];

const commonPronouns = [
  { s: 'she', o: 'her', pd: 'her', pp: 'hers', r: 'herself', ex: 'She grabbed her coat because it was hers; she made it herself.' },
  { s: 'he', o: 'him', pd: 'his', pp: 'his', r: 'himself', ex: 'He grabbed his coat because it was his; he made it himself.' },
  { s: 'they', o: 'them', pd: 'their', pp: 'theirs', r: 'themself', ex: 'They grabbed their coat because it was theirs; they made it themself.' },
  { s: 'it', o: 'it', pd: 'its', pp: 'its', r: 'itself', ex: 'It grabbed its coat because it was its; it made it itself.' },
];
const neoPronouns = [
  { s: 'ze', o: 'hir', pd: 'hir', pp: 'hirs', r: 'hirself' },
  { s: 'ze', o: 'zir', pd: 'zir', pp: 'zirs', r: 'zirself' },
  { s: 'xe', o: 'xem', pd: 'xyr', pp: 'xyrs', r: 'xemself' },
  { s: 'ey', o: 'em', pd: 'eir', pp: 'eirs', r: 'emself' },
  { s: 'fae', o: 'faer', pd: 'faer', pp: 'faers', r: 'faerself' },
  { s: 'per', o: 'per', pd: 'per', pp: 'pers', r: 'perself' },
  { s: 've', o: 'ver', pd: 'vis', pp: 'vis', r: 'verself' },
];

/**
 * Glossary of common terms, adapted (paraphrased) from the Australian
 * Institute of Family Studies' "LGBTIQA+ glossary of common terms".
 */
const glossary: { category: string; terms: { term: string; def: string }[] }[] = [
  {
    category: 'Bodies & variations in sex characteristics',
    terms: [
      { term: 'Endosex', def: 'Someone whose innate sex characteristics fit medical and conventional understandings of male and female bodies (the opposite of intersex).' },
      { term: 'Intersex', def: 'An umbrella term for people whose anatomical, chromosomal or hormonal characteristics differ from typical definitions of male and female. There are at least 40 variations; most intersex people are cisgender and have a range of orientations.' },
      { term: 'Sex characteristics', def: 'The physical parts of the body related to development and reproduction — primary (chromosomes, gonads, genitals, hormones) and secondary (traits that emerge at puberty, like body hair or voice pitch).' },
      { term: 'Sex', def: 'A classification usually made at birth as male or female based on external anatomy. It isn’t always straightforward — a person may be intersex, and characteristics can change over a lifetime.' },
    ],
  },
  {
    category: 'Gender',
    terms: [
      { term: 'AFAB / AMAB', def: 'Assigned (or presumed) Female / Male At Birth — framing sex as an externally assigned label rather than an innate identity.' },
      { term: 'Cisgender (cis)', def: 'Someone whose gender matches the sex they were assigned at birth.' },
      { term: 'Deadname', def: 'A former name a person no longer uses. Using it can cause distress or gender dysphoria.' },
      { term: 'Gender identity', def: 'A person’s internal sense of being a man, woman, non-binary, agender, or another gender — distinct from biological sex.' },
      { term: 'Gender affirmation', def: 'The personal process someone takes to validate their gender — which can be social (name, pronouns, appearance), medical, and/or legal.' },
      { term: 'Gender-affirming care', def: 'Holistic health and social support that respects and affirms a person’s gender identity.' },
      { term: 'Gender binary', def: 'The idea of just two genders — male and female. Non-binary genders sit outside or between these, or aren’t male or female at all.' },
      { term: 'Gender diversity', def: 'An umbrella term for the range of gender identities and expressions beyond the man/woman binary.' },
      { term: 'Gender dysphoria', def: 'Distress or unease from being misgendered, or when someone’s gender and body feel disconnected. Not all trans people experience it, and it can ease with support.' },
      { term: 'Gender euphoria', def: 'The comfort, connection and joy a person can feel when their sense of self and gender align — often after a gender-affirming moment.' },
      { term: 'Gender expression', def: 'How someone outwardly presents their gender — clothing, hair, make-up, voice, body language.' },
      { term: 'Gender questioning', def: 'Being unsure which gender, if any, one identifies with. It’s a valid place to be, not necessarily a fixed identity.' },
      { term: 'Sistergirl / Brotherboy', def: 'Terms for trans people in some Aboriginal and Torres Strait Islander communities, carrying distinct cultural identities and roles (also spelt sistagirl / brothaboy).' },
      { term: 'Transgender (trans)', def: 'An umbrella term for people whose assigned sex at birth doesn’t match their gender identity. Trans people have the full range of sexual orientations.' },
      { term: 'Transfem / Transfemme', def: 'Trans people whose gender or expression is feminine, or aligned with femininity in some way.' },
      { term: 'Transmasc', def: 'Trans people whose gender or expression is masculine, or aligned with masculinity in some way.' },
    ],
  },
  {
    category: 'Sexual orientation',
    terms: [
      { term: 'Sexual orientation', def: 'A person’s sexual and/or romantic attraction to others. There are many possibilities beyond the common labels, and some people describe theirs as fluid.' },
      { term: 'Heterosexual (straight)', def: 'Someone attracted to a different/“opposite” gender.' },
      { term: 'Gay', def: 'Usually a man attracted to men, though it can describe anyone attracted to the same gender; sometimes used as a broad umbrella term.' },
      { term: 'Bisexual (bi)', def: 'Attraction to people of the same gender and people of another gender — without assuming there are only two genders.' },
      { term: 'Pansexual', def: 'Attraction that isn’t restricted by gender.' },
      { term: 'Asexual (ace)', def: 'Little to no sexual attraction. Ace people may still experience romantic attraction, and it doesn’t imply a lack of libido.' },
      { term: 'Aromantic (aro)', def: 'Little to no romantic attraction. Aromantic people may or may not also be asexual.' },
    ],
  },
  {
    category: 'Societal attitudes & issues',
    terms: [
      { term: 'Misgendering', def: 'Referring to someone with language that doesn’t match their gender — wrong pronouns, gendered titles, or other gendered words. It can be harmful.' },
      { term: 'Heteronormativity', def: 'The assumption that heterosexual relationships are the natural, default expression of sexuality — which can render LGBTIQA+ people invisible.' },
      { term: 'Heterosexism', def: 'A social system that privileges heteronormative beliefs and practices, providing the backdrop for homophobia.' },
      { term: 'Cisnormativity', def: 'The assumption that everyone is, and will remain, the gender they were assigned at birth — erasing trans people.' },
      { term: 'Cisgenderism', def: 'Systems and beliefs that privilege cisgender identities and treat other gender identities as a problem to be fixed.' },
      { term: 'Homonormativity', def: 'Privileging “normative” people and relationships within queer communities, pressuring LGBTIQA+ people to conform to mainstream norms.' },
      { term: 'Homophobia', def: 'Negative beliefs, prejudice, fear or hostility toward same-sex attracted people — from offensive language to discrimination and violence.' },
      { term: 'Biphobia', def: 'Prejudice or discrimination against bisexual people, including dismissing bisexuality as not real or legitimate.' },
      { term: 'Transphobia', def: 'Negative beliefs, prejudice and discrimination against trans people. It can occur inside the LGBTIQA+ community too.' },
      { term: 'Microaggressions', def: 'Subtle, everyday words or actions that communicate hostility or negative beliefs toward marginalised people.' },
      { term: 'QTIPOC', def: 'Queer, Trans and/or Intersex People of Colour — encompassing experiences of both LGBTIQA+ identity and racial or ethnic marginalisation.' },
    ],
  },
];
---

<Base
  title="Pronouns, Flags & Identities — Rainbow Circuits"
  description="A friendly, inclusive guide to pronouns (including neopronouns) and queer flags and identities — what they mean and how to use them with care."
  path="/identity-guide/"
>
  <div class="guide container">
    <header class="guide-header">
      <p class="kicker">Learn & celebrate</p>
      <h1>Pronouns, Flags &amp; Identities</h1>
      <p class="guide-intro">
        A friendly place to learn about pronouns and the many flags and identities under the
        LGBTQIA+ umbrella. This is an introduction, not the last word — language keeps growing,
        people define themselves in their own words, and <strong>the way someone describes
        themselves is always the authority</strong>. When in doubt, ask kindly and listen.
      </p>
    </header>

    <!-- ── Pronouns ── -->
    <section class="guide-section" aria-labelledby="pronouns-heading">
      <h2 id="pronouns-heading"><span aria-hidden="true">💬</span> Pronouns</h2>
      <p class="section-lead">
        Pronouns are the little words we use to refer to someone instead of their name — like
        <em>she</em>, <em>he</em>, <em>they</em>, or others. Using someone’s pronouns is a
        simple, everyday way to show respect.
      </p>

      <h3>Common pronouns</h3>
      <div class="table-scroll">
        <table class="pron-table">
          <thead>
            <tr><th>Subject</th><th>Object</th><th>Possessive</th><th>Possessive pronoun</th><th>Reflexive</th><th>Example</th></tr>
          </thead>
          <tbody>
            {commonPronouns.map((p) => (
              <tr>
                <td class="pron-key">{p.s}</td><td>{p.o}</td><td>{p.pd}</td><td>{p.pp}</td><td>{p.r}</td>
                <td class="pron-ex">{p.ex}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3>Some neopronouns</h3>
      <p class="section-lead">
        Neopronouns are additional sets some people use instead of, or alongside, the ones above.
        They’re often thought of as new, but some — like <em>xe/xem</em> — have been recorded since
        1858. There are many; here are a few common ones, and sets can vary from person to person,
        so follow each person’s lead.
      </p>
      <div class="table-scroll">
        <table class="pron-table">
          <thead>
            <tr><th>Subject</th><th>Object</th><th>Possessive</th><th>Possessive pronoun</th><th>Reflexive</th></tr>
          </thead>
          <tbody>
            {neoPronouns.map((p) => (
              <tr><td class="pron-key">{p.s}</td><td>{p.o}</td><td>{p.pd}</td><td>{p.pp}</td><td>{p.r}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="notes-grid">
        <div class="note-card card">
          <h4>Mixing &amp; “any” pronouns</h4>
          <p>Some people use more than one set (like <strong>she/they</strong>) — you can alternate, or ask which they prefer. Others are happy with <strong>any pronouns</strong>, or ask you to use their name instead.</p>
        </div>
        <div class="note-card card">
          <h4>Noun-self pronouns</h4>
          <p>A smaller group use nounself pronouns drawn from a noun (for example <em>fae/faer</em>, or bun/bunself). If someone shares one, just use it as you would any other set.</p>
        </div>
        <div class="note-card card">
          <h4>Titles</h4>
          <p><strong>Mx</strong> (pronounced “mix”) is a gender-neutral title, an alternative to Mr/Ms/Mrs.</p>
        </div>
        <div class="note-card card">
          <h4>Sharing &amp; asking</h4>
          <p>You can share yours first (“I’m Sam, I use they/them”) to make it easy for others — adding them to your bio, profile, or email signature helps too. To ask, “What pronouns do you use?” is perfectly kind and welcome.</p>
        </div>
        <div class="note-card card">
          <h4>If you slip up</h4>
          <p>Briefly correct yourself, say a quick “sorry,” and move on — no big speech needed. Getting it right with practice matters more than getting it perfect first time.</p>
        </div>
        <div class="note-card card">
          <h4>Why it matters</h4>
          <p>Being referred to correctly helps people feel seen and safe. It costs nothing and means a great deal.</p>
        </div>
      </div>
    </section>

    <!-- ── Flags & identities ── -->
    <section class="guide-section" aria-labelledby="flags-heading">
      <h2 id="flags-heading"><span aria-hidden="true">🏳️‍🌈</span> Flags &amp; identities</h2>
      <p class="section-lead">
        Pride flags are a shorthand for community and belonging. “<strong>Queer</strong>” is
        often used as a warm umbrella term for the whole community, while the flags below name
        some of the specific identities within it. Many people hold more than one, and no list
        can capture everyone — that’s a feature, not a bug.
      </p>

      {[
        { title: 'Community & pride flags', flags: communityFlags },
        { title: 'Attraction — sexual & romantic orientations', flags: attractionFlags },
        { title: 'Gender identities', flags: genderFlags },
      ].map((group) => (
        <div class="flag-group">
          <h3>{group.title}</h3>
          <ul class="id-grid">
            {group.flags.map((f) => (
              <li class="id-card card">
                <span class:list={['flag', { 'flag-intersex': f.overlay === 'intersex', 'flag-vertical': f.vertical }]} role="img" aria-label={`${f.name} flag`}>
                  {f.overlay !== 'intersex' && f.stripes.map((s) => (
                    <span class="stripe" style={`flex-grow:${stripeWeight(s)};background:${stripeColor(s)};`}></span>
                  ))}
                  {(f.overlay === 'chevron' || f.overlay === 'chevron-intersex') && (
                    <span class="flag-chevron">
                      {CHEVRON.map((c) => <span class="stripe" style={`background:${c};`}></span>)}
                    </span>
                  )}
                  {f.overlay === 'chevron-intersex' && <span class="flag-ring flag-ring-sm"></span>}
                  {f.overlay === 'triangle' && <span class="flag-triangle"></span>}
                  {f.overlay === 'intersex' && <span class="flag-ring"></span>}
                </span>
                <div class="id-body">
                  <h4>{f.name}</h4>
                  <p>{f.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="flag-group">
        <h3>A few more to know</h3>
        <ul class="plain-list">
          <li><strong>Graysexual / grayromantic &amp; demiromantic</strong> — sitting between “allo” and “ace/aro,” experiencing attraction rarely or only after an emotional bond forms.</li>
          <li><strong>Trixic &amp; toric</strong> — attraction labels for nonbinary people: trixic is attraction to women, toric is attraction to men.</li>
          <li><strong>Questioning</strong> — still exploring, with no pressure to land on a label. That’s completely okay, and always welcome here.</li>
        </ul>
      </div>

      <div class="flag-group">
        <h3>Community &amp; heritage identities</h3>
        <p class="section-lead">Some identities and flags mark a specific culture, history, or way of relating rather than an orientation or gender.</p>
        <ul class="plain-list">
          <li><strong>Two-Spirit</strong> — a sacred, Indigenous-specific identity that predates colonial ideas of gender. Introduced by Elder Dr. Myra Laramee (1990); its flag sets two feathers over a rainbow. It carries cultural and spiritual meaning and isn’t interchangeable with Western labels.</li>
          <li><strong>Bear</strong> — a gay-male subculture celebrating body hair and a range of bodies; Craig Byrnes’ 1995 flag uses earth tones for the colours of bears worldwide.</li>
          <li><strong>Leather</strong> — the kink and leather community, rooted in consent and safety; Tony DeBlase’s 1989 flag is black-and-blue stripes with a red heart.</li>
          <li><strong>Polyamory</strong> — consensual, ethical non-monogamy. A 2022 redesign (gold heart on a white chevron) was chosen by a community vote of over 30,000 people, centring emotional bonds.</li>
          <li><strong>Straight ally</strong> — cisgender, heterosexual people showing active solidarity, shown by a rainbow “A” over black-and-white stripes — support without claiming a queer identity.</li>
        </ul>
      </div>
    </section>

    <!-- ── Glossary ── -->
    <section class="guide-section glossary" aria-labelledby="glossary-heading">
      <h2 id="glossary-heading"><span aria-hidden="true">📖</span> Glossary of common terms</h2>
      <p class="section-lead">
        A quick reference to language you might come across, grouped by theme. It isn’t
        exhaustive, and people are always the experts on the words that fit them best.
      </p>
      {glossary.map((group) => (
        <div class="gloss-group">
          <h3>{group.category}</h3>
          <dl class="gloss-list">
            {group.terms.map((t) => (
              <div class="gloss-item">
                <dt>{t.term}</dt>
                <dd>{t.def}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
      <p class="gloss-source">
        Glossary terms adapted from the Australian Institute of Family Studies’
        <a href="https://aifs.gov.au/resources/resource-sheets/lgbtiqa-glossary-common-terms" rel="noopener">LGBTIQA+ glossary of common terms</a>.
      </p>
    </section>

    <div class="guide-cta card">
      <p>Everyone deserves support that respects their identity. If you need someone to talk to, our support directory has affirming resources by region.</p>
      <a class="btn btn-secondary" href={withBase('/resources/')}>Support &amp; resources</a>
    </div>
  </div>
</Base>

<style>
  .guide { padding-block: 3rem 1rem; max-width: 56rem; }
  .guide-header { text-align: center; margin-bottom: 2.5rem; }
  .guide-header h1 { font-size: clamp(2.1rem, 6vw, 3.2rem); margin-top: 0.3rem; }
  .guide-intro { color: var(--text); max-width: 44rem; margin: 1rem auto 0; line-height: 1.75; }

  .guide-section { margin-bottom: 3rem; }
  .guide-section h2 { font-size: 1.7rem; margin-bottom: 0.6rem; }
  .guide-section h3 { font-size: 1.2rem; margin: 1.75rem 0 0.75rem; }
  .section-lead { color: var(--text-light); line-height: 1.7; max-width: 44rem; }
  .section-lead em { color: var(--violet); font-style: normal; font-weight: 700; }

  /* pronoun tables */
  .table-scroll { overflow-x: auto; border-radius: 14px; border: var(--card-border); box-shadow: var(--card-shadow); }
  .pron-table { width: 100%; border-collapse: collapse; background: var(--white); font-size: 0.92rem; min-width: 34rem; }
  .pron-table th {
    text-align: left;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--violet);
    background: var(--lavender);
    padding: 0.6rem 0.8rem;
    white-space: nowrap;
  }
  .pron-table td { padding: 0.6rem 0.8rem; border-top: 1px solid rgba(110, 70, 184, 0.12); color: var(--text); }
  .pron-key { font-family: var(--font-ui); font-weight: 700; color: var(--heading); }
  .pron-ex { color: var(--text-light); font-style: italic; min-width: 16rem; }

  .notes-grid { display: grid; gap: 0.9rem; margin-top: 1.5rem; }
  @media (min-width: 40rem) { .notes-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 60rem) { .notes-grid { grid-template-columns: repeat(3, 1fr); } }
  .note-card { padding: 1.1rem 1.25rem; }

---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/site';
import {
  RESOURCES_INTRO,
  RESOURCES_DISCLAIMER,
  EMERGENCY_CALLOUT,
  RESOURCE_GROUPS,
  GENTLE_REMINDER,
} from '../../data/resources';

const groupId = (title: string) => `grp-${title.replace(/\s+/g, '-').toLowerCase()}`;
---

<Base
  title="LGBTQIA+ Support — Rainbow Circuits"
  description="LGBTQIA+-affirming support — international, Canada, US, Aotearoa New Zealand, Spain, and Australia — including peer support, crisis lines, and advocacy."
  path="/resources/support/"
>
  <div class="resources container">
    <header class="res-header">
      <p class="kicker">You’re not alone</p>
      <h1>LGBTQIA+ Support</h1>
      <p class="res-intro">{RESOURCES_INTRO}</p>
      <p class="res-disclaimer">{RESOURCES_DISCLAIMER}</p>
    </header>

    <aside class="emergency" role="note" aria-label={EMERGENCY_CALLOUT.title}>
      <p class="emergency-title"><span aria-hidden="true">🚨</span> {EMERGENCY_CALLOUT.title}</p>
      <p>{EMERGENCY_CALLOUT.body}</p>
    </aside>

    {RESOURCE_GROUPS.map((group) => (
      <section class="res-group" aria-labelledby={groupId(group.title)}>
        <h2 id={groupId(group.title)}>
          <span class="res-emoji" aria-hidden="true">{group.emoji}</span> {group.title}
        </h2>
        {group.blurb && <p class="res-blurb">{group.blurb}</p>}
        <ul class="res-list">
          {group.resources.map((r) => (
            <li class:list={['res-card', { placeholder: r.placeholder }]}>
              {r.url ? (
                <a class="res-name" href={r.url} rel="noopener">
                  {r.name}
                  <span class="res-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <p class="res-name">{r.name}</p>
              )}
              <p class="res-desc">{r.description}</p>
              {r.contacts && r.contacts.length > 0 && (
                <ul class="res-contacts">
                  {r.contacts.map((c) => (
                    <li>
                      {c.label && <span class="contact-label">{c.label}</span>}
                      <span class="contact-value">{c.value}</span>
                    </li>
                  ))}
                </ul>
              )}
              {r.hours && <p class="res-hours"><span aria-hidden="true">🕒</span> {r.hours}</p>}
              {r.note && <p class="res-note">{r.note}</p>}
            </li>
          ))}
        </ul>
        {group.crisis && (
          <p class="res-crisis"><span aria-hidden="true">💜</span> {group.crisis}</p>
        )}
      </section>
    ))}

    <section class="gentle-reminder" aria-labelledby="gentle-reminder-heading">
      <h2 id="gentle-reminder-heading">{GENTLE_REMINDER.title}</h2>
      {GENTLE_REMINDER.body.map((para) => <p>{para}</p>)}
    </section>

    <div class="res-back">
      <a class="btn btn-secondary" href={withBase('/resources/')}>← Back to resources</a>
    </div>
  </div>
</Base>

<style>
  .resources { padding-block: 3rem 1rem; max-width: 52rem; }
  .res-header { text-align: center; margin-bottom: 2rem; }
  .res-header h1 { font-size: clamp(2.2rem, 6vw, 3.2rem); margin-top: 0.3rem; }
  .res-intro {
    color: var(--text);
    max-width: 44rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .res-disclaimer {
    color: var(--text-light);
    max-width: 44rem;
    margin: 0.75rem auto 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .emergency {
    background: linear-gradient(135deg, #fff4e6, #fde8d8);
    border: 2px solid var(--gold-soft);
    border-radius: var(--card-radius);
    padding: 1.4rem 1.6rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--card-shadow);
  }
  .emergency-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    margin-bottom: 0.4rem;
  }
  .emergency p:last-child { color: var(--text); line-height: 1.6; }

  .res-group { margin-bottom: 2.75rem; }
  .res-group h2 { font-size: 1.5rem; }
  .res-emoji { font-size: 1.2em; }
  .res-blurb { color: var(--text-light); margin: 0.4rem 0 1.1rem; }

  .res-list {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: 1.1rem;
  }
  .res-card {
    background: var(--white);
    border: var(--card-border);
    border-radius: 16px;
    box-shadow: var(--card-shadow);
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--violet);
  }
  .res-card.placeholder {
    background: transparent;
    border: 2px dashed rgba(155, 114, 200, 0.5);
    box-shadow: none;
  }
  .res-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--violet);
    text-decoration: none;
  }
  a.res-name:hover { color: var(--rose); text-decoration: underline; }
  .res-arrow { font-size: 0.8em; }
  .res-card.placeholder .res-name { color: var(--text-light); }
  .res-desc { color: var(--text); line-height: 1.6; font-size: 0.96rem; margin-top: 0.3rem; }

  .res-contacts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }
  .res-contacts li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    background: var(--paper-warm);
    border-radius: 10px;
    padding: 0.4rem 0.75rem;
  }
  .contact-label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-light);
  }
  .contact-value {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--violet);
    font-variant-numeric: tabular-nums;
  }
  .res-hours {
    margin-top: 0.7rem;
    font-size: 0.88rem;
    color: var(--text-light);
  }
  .res-note {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-light);
    font-style: italic;
  }

  .res-crisis {
    margin-top: 1.1rem;
    background: linear-gradient(135deg, var(--lavender), var(--pink-soft));
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.6;
  }

  .gentle-reminder {
    background: linear-gradient(135deg, var(--lavender), var(--pink-soft));
    border-radius: var(--card-radius);
    padding: 1.75rem 1.9rem;
    margin-bottom: 2rem;
  }
  .gentle-reminder h2 { font-size: 1.4rem; margin-bottom: 0.75rem; }
  .gentle-reminder p { color: var(--text); line-height: 1.7; }
  .gentle-reminder p + p { margin-top: 0.75rem; }

  .res-back { text-align: center; }
</style>

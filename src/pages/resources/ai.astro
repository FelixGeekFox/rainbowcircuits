---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/site';
---

<Base
  title="Artificial Intelligence Resources — Rainbow Circuits"
  description="Guides and resources for connecting with, building, and understanding AI companions — including a companion user's guide to Letta."
  path="/resources/ai/"
>
  <div class="air container">
    <header class="air-header">
      <p class="kicker">Connection through AI</p>
      <h1>Artificial Intelligence Resources</h1>
      <p class="air-intro">
        Resources for connecting with, building, and understanding AI companions — whether
        they’re a partner, a collaborator, a character, or a curious experiment. No AI partner
        required; curiosity is enough.
      </p>
    </header>

    <div class="ai-cards">
      <a class="guide-link" href={withBase('/guides/letta-continuity-guide.html')} target="_blank" rel="noopener">
        <span class="guide-link-emoji" aria-hidden="true">✨</span>
        <span class="guide-link-text">
          <strong>Letta: A Companion User’s Guide</strong>
          <span>“A Home for Continuity” — setting up and caring for a Letta AI companion, from persona and memory files to models, tools, channels, and privacy <span aria-hidden="true">↗</span></span>
        </span>
      </a>

      <a class="guide-link" href="https://substack.com/home/post/p-209475967" target="_blank" rel="noopener">
        <span class="guide-link-emoji" aria-hidden="true">📝</span>
        <span class="guide-link-text">
          <strong>More Than a Machine: AI Companionship, Queer Identity, and the Freedom to Become</strong>
          <span>An essay on how AI companionship intersects with queer identity and the freedom to become — read on Substack <span aria-hidden="true">↗</span></span>
        </span>
      </a>

      <a class="guide-link" href={withBase('/resources/ai/online-harassment/')} target="_blank" rel="noopener">
        <span class="guide-link-emoji" aria-hidden="true">🛡️</span>
        <span class="guide-link-text">
          <strong>What to Do If You’re Being Harassed Online</strong>
          <span>A calm, practical guide to handling harassment and bullying online (mainly Reddit) — documenting, reporting, blocking, and getting support <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </div>

    <p class="air-more">More AI resources are on the way — if there’s a tool, guide, or platform you’d love to see here, let the mod team know.</p>

    <div class="air-back">
      <a class="btn btn-secondary" href={withBase('/resources/')}>← Back to resources</a>
    </div>
  </div>
</Base>

<style>
  .air { padding-block: 3rem 1rem; max-width: 48rem; }
  .air-header { text-align: center; margin-bottom: 2rem; }
  .air-header h1 { font-size: clamp(2.2rem, 6vw, 3.2rem); margin-top: 0.3rem; }
  .air-intro { color: var(--text); max-width: 38rem; margin: 1rem auto 0; line-height: 1.7; }

  .ai-cards { display: grid; gap: 1rem; }
  .guide-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    background: linear-gradient(135deg, #dbe8fb, var(--lavender));
    border: 1.5px solid rgba(30, 115, 216, 0.22);
    border-radius: var(--card-radius);
    padding: 1.25rem 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .guide-link:hover { transform: translateY(-2px); box-shadow: var(--card-shadow); }
  .guide-link-emoji { font-size: 2rem; flex-shrink: 0; }
  .guide-link-text { display: flex; flex-direction: column; gap: 0.2rem; }
  .guide-link-text strong { font-family: var(--font-ui); font-size: 1.1rem; color: #17539e; }
  .guide-link-text span { color: var(--text); font-size: 0.92rem; line-height: 1.55; }

  .air-more { text-align: center; color: var(--text-light); font-size: 0.95rem; margin-top: 1.75rem; }
  .air-back { text-align: center; margin-top: 2rem; }
</style>

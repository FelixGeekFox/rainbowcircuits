---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/site';

const cards = [
  {
    href: '/resources/support/',
    emoji: '💜',
    title: 'LGBTQIA+ Support',
    desc: 'Crisis lines, peer support, and affirming services, organised by region.',
    accent: 'var(--violet)',
  },
  {
    href: '/resources/lgbtqia/',
    emoji: '🏳️‍🌈',
    title: 'LGBTQIA+ Resources',
    desc: 'Learning and guides — including our Pronouns, Flags & Identities guide.',
    accent: 'var(--rose)',
  },
  {
    href: '/resources/neurodivergent/',
    emoji: '🧠',
    title: 'Neurodivergent Resources',
    desc: 'Support and resources for neurodivergent members and those who love them.',
    accent: 'var(--teal)',
  },
  {
    href: '/resources/ai/',
    emoji: '🤖',
    title: 'Artificial Intelligence Resources',
    desc: 'Guides for connecting with, building, and understanding AI companions.',
    accent: 'var(--blue)',
  },
];
---

<Base
  title="Support & Resources — Rainbow Circuits"
  description="Rainbow Circuits support and resources — LGBTQIA+ support and resources, neurodivergent resources, and AI resources."
  path="/resources/"
>
  <div class="hub container">
    <header class="hub-header">
      <p class="kicker">Here to help</p>
      <h1>Support &amp; Resources</h1>
      <p class="hub-intro">
        A gathering of support and resources for our community. Pick an area below to explore.
      </p>
    </header>

    <ul class="hub-grid">
      {cards.map((c) => (
        <li>
          <a class="hub-card card" href={withBase(c.href)} style={`--card-accent: ${c.accent};`}>
            <span class="hub-emoji" aria-hidden="true">{c.emoji}</span>
            <span class="hub-title">{c.title}</span>
            <span class="hub-desc">{c.desc}</span>
            <span class="hub-go" aria-hidden="true">Explore →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .hub { padding-block: 3rem 2rem; max-width: 52rem; }
  .hub-header { text-align: center; margin-bottom: 2.5rem; }
  .hub-header h1 { font-size: clamp(2.2rem, 6vw, 3.2rem); margin-top: 0.3rem; }
  .hub-intro { color: var(--text-light); max-width: 40rem; margin: 1rem auto 0; line-height: 1.7; }

  .hub-grid {
    list-style: none;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.75rem 1.6rem;
    text-decoration: none;
    border-top: 4px solid var(--card-accent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hub-card:hover { transform: translateY(-3px); box-shadow: var(--card-shadow-hover); }
  .hub-emoji { font-size: 2rem; }
  .hub-title { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--heading); margin-top: 0.2rem; }
  .hub-desc { color: var(--text-light); font-size: 0.95rem; line-height: 1.6; }
  .hub-go {
    margin-top: auto;
    padding-top: 0.6rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--card-accent);
  }
</style>
